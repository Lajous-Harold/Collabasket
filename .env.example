# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_anon_key_here

# Google OAuth
# Web Client ID (OBLIGATOIRE) : sert d'audience aux idToken generes
# par les SDK natifs Android et iOS. Recupere depuis Google Cloud
# Console > APIs & Services > Credentials > OAuth 2.0 Client (Web).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# iOS Client ID (utilise par GoogleSignin.configure sur iOS uniquement).
# Pas necessaire en Android-only mais a remplir pour la wave iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here
